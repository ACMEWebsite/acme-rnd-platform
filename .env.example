APP_HOST=localhost
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_HTTPS_ENABLED=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,acme-rnd.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://acme-rnd.local

POSTGRES_DB=acme_rnd
POSTGRES_USER=acme_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_ENGINE=postgresql

# Optional external enrichment. Direct SMILES predictions remain local when
# these values are omitted.
MOLGPKA_TOKEN=
MOLGPKA_UPLOAD_URL=http://xundrug.cn:5001/modules/upload0/
REGULATIONS_GOV_API_KEY=DEMO_KEY
ENABLE_PSG_LIVE_SCRAPE=false

# Literature review is local-only by default. Setting this to true permits a
# user who explicitly opts in to send extracted document text to Gemini.
LITERATURE_EXTERNAL_AI_ENABLED=false
LITERATURE_OCR_LANGUAGES=eng
LITERATURE_OCR_DPI=200
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Optional web search enrichment for properties not supplied by PubChem or
# ChEMBL. This sends search queries to Tavily and is disabled when omitted.
TAVILY_API_KEY=
