:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host localhost
        }
    }
    handle /admin/* {
        reverse_proxy backend:8000 {
            header_up Host localhost
        }
    }
    handle /health/* {
        reverse_proxy backend:8000 {
            header_up Host localhost
        }
    }
    handle_path /static/* {
        root * /static
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        -Server
        Cache-Control "no-cache, no-store, must-revalidate"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
}
